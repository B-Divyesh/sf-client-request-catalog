{
  "name": "client-request-catalog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e tests",
    "check": "npm run typecheck && npm run lint",
    "audit:copy": "npm run build && node scripts/copy-audit.mjs --check",
    "audit:copy:update": "npm run build && node scripts/copy-audit.mjs --update",
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "cargo build --manifest-path backend/Cargo.toml && node --test tests/runtime-claims.mjs",
    "test:e2e": "npm run build && node scripts/copy-audit.mjs --check && cargo build --manifest-path backend/Cargo.toml && node scripts/prepare-e2e.mjs && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.4.1",
    "eslint": "^9.34.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "1.58.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0"
  }
}
